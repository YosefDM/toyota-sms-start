# Copy to .env and fill in. NEVER commit the real .env (it's gitignored).

# The TextGrid number's Webhook Secret — used to verify inbound requests are really
# from TextGrid. (This is NOT the auth token; it's the per-number webhook secret.)
# If unset, signature checks are skipped (dev only) — SET THIS IN PRODUCTION.
TEXTGRID_WEBHOOK_SECRET=

# The exact public HTTPS URL configured as the number's smsUrl. Must match byte-for-byte
# (scheme, host, path) — it's part of the signed payload.
PUBLIC_URL=https://your-public-host/sms

# Comma-separated E.164 numbers allowed to command the car (your basic phone).
ALLOWED_NUMBERS=+15551234567

# adb wiring (defaults are fine for a single local emulator).
ADB_PATH=adb
ADB_SERIAL=emulator-5554
HOLD_MS=3500
RATE_LIMIT_SECONDS=8
RESULT_TIMEOUT=25

# --- Outbound sending (not needed for inbound replies, which go back as TwiML).
# --- Required later for operator alerts / the OTP re-auth relay. TextGrid's send API is
# --- Twilio-compatible: the Twilio SDK works with client.api.base_url = TEXTGRID_BASE_URL.
# TEXTGRID_ACCOUNT_SID=
# TEXTGRID_AUTH_TOKEN=
# TEXTGRID_PHONE_NUMBER=+1234567890
# TEXTGRID_BASE_URL=https://api.textgrid.com
