# NOTE: git .gitignore does NOT support inline (end-of-line) comments — a '#' only
# starts a comment at the start of a line. Keep every pattern on its own line.

# ───────── Secrets / personal — NEVER commit ─────────
# config.js contains the TLS-filter CA (CERT_PEM); combined_unpin.js embeds it.
scripts/frida/config.js
scripts/frida/combined_unpin.js
# GCP service-account keys (CI deploy uses a GitHub secret, never a file in the repo)
sa-key.json
*-sa-key.json
service-account*.json
gcp-*.json
**/*.keybox.xml
.env
# ...and every sideways copy of it. A timestamped backup (made before editing the live .env on the
# rig) is still a full set of secrets, and `.env` alone does not match `.env.bak.1791780133`.
.env.*
*.env.bak*
# .env.example is committed on purpose (it IS the documentation) and `.env.*` above matches it.
# Today it survives only because it is already tracked, which stops being true the moment anyone
# removes and re-adds it, so say so explicitly.
!.env.example
*.pem
*.crt
*.cer
# Android hashed CA files (e.g. 6f2a8e1c.0)
*.0
secrets/
twilio.env

# ───────── 3rd-party scripts fetched at setup (see docs/SETUP.md) ─────────
scripts/frida/android-certificate-unpinning*.js
scripts/frida/disable-flutter-tls*.js

# ───────── Large / binary / proprietary — do NOT redistribute ─────────
*.apk
*.apkm
*.xapk
*.apks
apkeep/
toyota_split/
frida-server*
Magisk*.zip
Magisk*.apk
# Android system/ramdisk images
*.img
# decompiled app sources (copyrighted)
jadxout/
*.so

# ───────── Tooling / junk ─────────
toyvenv*/
*venv*/
__pycache__/
*.pyc
node_modules/
*.log
ui.xml
# screenshots/dumps (may show account/vehicle info)
*.png
scratchpad/
.DS_Store
Thumbs.db

# UI capture library (screenshots/dumps may show vehicle/account data)
ui-map/
