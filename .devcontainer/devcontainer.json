{
  // Lean Codespace: a small Python 3.12 image instead of the multi-GB "universal" default.
  "name": "Kestrel",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "hostRequirements": { "cpus": 2 },
  // Matches CLAUDE.md commands (.venv/bin/pytest, .venv/bin/python).
  "postCreateCommand": "python -m venv .venv && .venv/bin/pip install -q -U pip && .venv/bin/pip install -q -e '.[dev,alpaca]'",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": { "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python" }
    }
  }
}
